model GiftCode {
  id          String               @id @default(uuid())
  code        String               @unique
  amount      Decimal              @db.Decimal(12, 2)
  maxUses     Int
  usedCount   Int                  @default(0)
  active      Boolean              @default(true)
  deletedAt   DateTime?
  createdAt   DateTime             @default(now())
  redemptions GiftCodeRedemption[]
}

