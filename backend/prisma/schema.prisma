// Home-screen popups the admin manages from the panel: each is one image,
// shown in sortOrder when the app opens. Deleting only marks the row (and
// drops its image) so the seeded popup isn't re-created on the next deploy.
model Popup {
  id        String    @id @default(uuid())
  title     String
  image     Bytes
  mimeType  String
  width     Int
  height    Int
  sortOrder Int
  active    Boolean   @default(true)
  // "POPUP" = shown once on app open; "SLIDER" = auto-sliding banner at the top of Home;
  // "CATEGORY_SLIDER" = auto-sliding banner at the top of the game category screen.
  kind      String    @default("POPUP")
  // Sliders only: optional button text, and the game it opens.
  buttonText   String?
  buttonTarget String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt, sortOrder])
}

