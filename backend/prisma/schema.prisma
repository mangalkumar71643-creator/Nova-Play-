generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A one-time SMS login code for a phone number. Not linked to User by FK
// since a brand-new phone number won't have a User row yet — request/
// verify/complete-profile all key off the raw phone string instead.
model PhoneOtp {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  /// Who asked for the code (first X-Forwarded-For hop), for the daily per-IP limit.
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([phone])
  @@index([ip, createdAt])
}

enum Role {
  USER
  ADMIN
}

enum KycStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BET_STAKE
  BET_PAYOUT
  BET_REFUND
  GAME_STAKE
  GAME_PAYOUT
  BONUS
  DEPOSIT_BONUS
  WITHDRAWAL_REVERSAL
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum EventStatus {
  SCHEDULED
  LIVE
  FINISHED
  CANCELLED
}

enum MarketStatus {
  OPEN
  SUSPENDED
  SETTLED
}

enum BetStatus {
  PENDING
  WON
  LOST
  VOID
}

enum SupportTicketStatus {
  OPEN
  RESOLVED
}

enum ChatSender {
  USER
  ADMIN
}

enum ColorGameBetType {
  NUMBER
  COLOR
  SIZE
}

enum ColorGameColor {
  GREEN
  RED
  VIOLET
}

enum ColorGameSize {
  BIG
  SMALL
}

enum ChickenRoadDifficulty {
  EASY
  MEDIUM
  HARD
  HARDCORE
}

model User {
  id           String    @id @default(uuid())
  // Short public-facing account number shown to the player (mobile UI's
  // "UID") — kept separate from `id` (the internal uuid every other
  // table's foreign keys point at) so this can be short/numeric without
  // touching any relation. Nullable so `prisma db push` can add the
  // column without a default; every create path generates one, and any
  // pre-existing row without one gets backfilled by prisma/seed.ts.
  uid          Int?      @unique
  email        String?   @unique
  passwordHash String?
  phone        String?   @unique
  firstName    String
  lastName     String
  dateOfBirth  DateTime
  country      String
  role         Role      @default(USER)
  kycStatus    KycStatus @default(NOT_STARTED)

  // Admin-initiated ban (distinct from the user's own isSelfExcluded) —
  // for rule violations. Checked in middleware/auth.ts's requireAuth so a
  // ban takes effect immediately, not just on the next login.
  isBanned  Boolean   @default(false)
  banReason String?
  bannedAt  DateTime?

  // Responsible gambling
  isSelfExcluded      Boolean   @default(false)
  selfExclusionUntil  DateTime?
  depositLimitDaily   Decimal?  @db.Decimal(12, 2)
  depositLimitWeekly  Decimal?  @db.Decimal(12, 2)
  depositLimitMonthly Decimal?  @db.Decimal(12, 2)

  // Daily login bonus (server-authoritative — see gameEngineService)
  dailyStreak      Int       @default(0)
  lastDailyClaimAt DateTime?

  // Provably-fair game RNG state — see fairnessService.ts. serverSeed is
  // never exposed to the client until rotated; serverSeedHash is shown
  // upfront so a player can verify, after rotation, that it wasn't
  // changed mid-play.
  fairnessServerSeed     String?
  fairnessServerSeedHash String?
  fairnessClientSeed     String?
  fairnessNonce          Int     @default(0)
  /// When a round last took a nonce; the server seed is not rotated (revealed) right after, so a round still starting can't have its seed exposed.
  fairnessNonceUsedAt    DateTime?

  // Payout bank account for withdrawals. Required before a withdrawal is
  // accepted — see the check in wallet.routes.ts POST /withdraw.
  payoutAccountHolderName String?
  payoutAccountNumber     String?
  payoutIfsc              String?

  // One-time first-deposit bonus, see paymentService.ts / wallet.routes.ts.
  firstDepositBonusClaimed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet             Wallet?
  revealedSeeds      RevealedServerSeed[]
  transactions       Transaction[]
  bets               Bet[]
  gameRounds         GameRound[]
  kycVerifications   KycVerification[]
  supportTickets     SupportTicket[]
  colorGameBets      ColorGameBet[]
  aviatorBets        AviatorBet[]
  chickenRoadRounds  ChickenRoadRound[]
  minesRounds        MinesRound[]
  sevenUpDownBets    SevenUpDownBet[]
  plinkoBets         PlinkoBet[]
  dragonTigerBets    DragonTigerBet[]
  vortexRounds       VortexRound[]
  AndarBaharBet      AndarBaharBet[]
  TeenPattiBet       TeenPattiBet[]
  CricketXBet        CricketXBet[]
  RocketBet          RocketBet[]
  GoalRushBet        GoalRushBet[]
  BigCatchBet        BigCatchBet[]
  CosmonautBet       CosmonautBet[]
  SkyJetBet          SkyJetBet[]
  SkyJetJackpotWin   SkyJetJackpotWin[]
  NightRacerBet      NightRacerBet[]
  AirshipBet         AirshipBet[]
  ZeusSpin           ZeusSpin[]
  WolfMoonSpin       WolfMoonSpin[]
  PenaltyRound       PenaltyRound[]
  CupsRound          CupsRound[]
  BombRound          BombRound[]
  VaultRound         VaultRound[]
  TreasureRound      TreasureRound[]
  WheelSpin          WheelSpin[]
  ScratchTicket      ScratchTicket[]
  DiceDuelBet        DiceDuelBet[]
  ColorBallBet       ColorBallBet[]
  FortuneSixBet      FortuneSixBet[]
  fruitMachineSpins  FruitMachineSpin[]
  fishermanSpins     FishermanSpin[]
  bookOfPharaohSpins BookOfPharaohSpin[]
  JhandiMundaBet     JhandiMundaBet[]
  RouletteBet        RouletteBet[]
  K3Bet              K3Bet[]
  WinGoBet           WinGoBet[]
  FiveDBet           FiveDBet[]
  TrxBet             TrxBet[]
  BaccaratBet        BaccaratBet[]
  SlotSpin           SlotSpin[]
  AcesSpin           AcesSpin[]
  DiceBet            DiceBet[]
  LimboBet           LimboBet[]
  BlackjackHand      BlackjackHand[]
  KenoBet            KenoBet[]
  HiloRound          HiloRound[]
  DragonTowerRound   DragonTowerRound[]
  VideoPokerRound    VideoPokerRound[]
  DiamondsBet        DiamondsBet[]
  PumpRound          PumpRound[]
  CoinFlipRound      CoinFlipRound[]
  CasinoHoldemHand   CasinoHoldemHand[]
  ThreeCardPokerHand ThreeCardPokerHand[]
  CandyBlastSpin     CandyBlastSpin[]
  Neon777Spin        Neon777Spin[]
  MoneyComingSpin    MoneyComingSpin[]
  GiftCodeRedemption GiftCodeRedemption[]
  VipBonusClaim      VipBonusClaim[]
}

model KycVerification {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  provider            String
  providerReferenceId String?
  status              KycStatus @default(PENDING)
  rawResult           Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Wallet {
  id       String  @id @default(uuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id])
  balance  Decimal @default(0) @db.Decimal(12, 2)
  currency String  @default("GBP")

  // Bonus funds already added to `balance` (so they're immediately
  // playable) but not yet withdrawable until `wageringProgress` reaches
  // `wageringRequired` — standard "wagering requirement" mechanic. Both
  // reset to 0 once met. See paymentService.ts (grant) and
  // gameEngineService.ts (progress) and wallet.routes.ts (withdraw gate).
  lockedBonus      Decimal @default(0) @db.Decimal(12, 2)
  wageringRequired Decimal @default(0) @db.Decimal(12, 2)
  wageringProgress Decimal @default(0) @db.Decimal(12, 2)

  // Deposited (or admin-credited) money not yet staked in a game. Only the
  // rest — what came back as winnings — can be withdrawn. Kept by a database
  // trigger on "Transaction" (see prisma/seed.ts, ensureUnplayedDepositTrigger):
  // a completed DEPOSIT or admin credit adds to it, every GAME_STAKE /
  // BET_STAKE takes from it, so every game is covered without its own code.
  unplayedDeposit Decimal @default(0) @db.Decimal(12, 2)

  updatedAt DateTime @updatedAt
}

model Transaction {
  id                  String            @id @default(uuid())
  userId              String
  user                User              @relation(fields: [userId], references: [id])
  type                TransactionType
  amount              Decimal           @db.Decimal(12, 2)
  status              TransactionStatus @default(PENDING)
  provider            String?
  providerReferenceId String?
  betId               String?
  bet                 Bet?              @relation(fields: [betId], references: [id])
  createdAt           DateTime          @default(now())

  @@index([userId, createdAt])
}

// Retired: the sportsbook (Sport / Event / Market / Selection / Bet) had no
// screen in the app and its endpoints are gone. Kept read-only so past
// records stay; open bets were refunded by retiredGamesCloseout.ts.
model Sport {
  id     String  @id @default(uuid())
  name   String  @unique
  slug   String  @unique
  events Event[]
}

model Event {
  id        String      @id @default(uuid())
  sportId   String
  sport     Sport       @relation(fields: [sportId], references: [id])
  name      String
  startTime DateTime
  status    EventStatus @default(SCHEDULED)
  markets   Market[]
  createdAt DateTime    @default(now())
}

model Market {
  id         String       @id @default(uuid())
  eventId    String
  event      Event        @relation(fields: [eventId], references: [id])
  name       String
  status     MarketStatus @default(OPEN)
  selections Selection[]
  createdAt  DateTime     @default(now())
}

model Selection {
  id       String   @id @default(uuid())
  marketId String
  market   Market   @relation(fields: [marketId], references: [id])
  name     String
  odds     Decimal  @db.Decimal(8, 2)
  isWinner Boolean?
  bets     Bet[]
}

// One round of a real-money "game" (see gameEngineService.ts). Outcomes
// are "provably fair" (HMAC-SHA256 of serverSeed/clientSeed/nonce — see
// fairnessService.ts) — a player can independently recompute the result
// once serverSeedHash's underlying seed is revealed via seed rotation.
// This is NOT the same as accredited RNG certification, which a real
// casino licence still requires; that is a compliance step outside this
// codebase.
// Retired: the old instant Dice / Coin Flip games (no screen in the app).
// Kept read-only so past plays stay on record.
model GameRound {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  gameKey        String
  gameType       String // "coinflip" | "dice"
  target         Int? // dice only: the roll-under target the player chose
  stake          Decimal  @db.Decimal(12, 2)
  multiplier     Decimal  @db.Decimal(8, 4)
  payout         Decimal  @db.Decimal(12, 2)
  won            Boolean
  serverSeedHash String
  clientSeed     String
  nonce          Int
  createdAt      DateTime @default(now())
}

// A server seed's value is only ever revealed once rotated out — this is
// what lets a player verify past rounds played under its hash.
model RevealedServerSeed {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  serverSeed     String
  serverSeedHash String
  createdAt      DateTime @default(now())
}

// Raised when a user's issue isn't solved by the in-app FAQ (see
// support.routes.ts). Shown to staff on the priority support dashboard
// (public/admin-support.html) so real escalations get a real response.
model SupportTicket {
  id         String              @id @default(uuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id])
  topic      String
  message    String?
  status     SupportTicketStatus @default(OPEN)
  createdAt  DateTime            @default(now())
  resolvedAt DateTime?
  messages   ChatMessage[]
}

// One message in a Live Support conversation (see support.routes.ts /
// admin.routes.ts and public/chat.html + admin-support.html). Always
// belongs to a SupportTicket, which doubles as the conversation thread.
model ChatMessage {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])
  sender    ChatSender
  text      String
  createdAt DateTime      @default(now())
}

model Bet {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  selectionId     String
  selection       Selection     @relation(fields: [selectionId], references: [id])
  stake           Decimal       @db.Decimal(12, 2)
  odds            Decimal       @db.Decimal(8, 2)
  potentialPayout Decimal       @db.Decimal(12, 2)
  status          BetStatus     @default(PENDING)
  createdAt       DateTime      @default(now())
  settledAt       DateTime?
  transactions    Transaction[]
}

// "Color Predict" — a fixed-interval number-draw game (see
// colorGameService.ts). Unlike GameRound (per-user, per-click), a round
// here is shared by every player and runs on a wall-clock timer per
// duration track (30s/1m/3m/5m/10m). Provably fair via commit-reveal:
// serverSeedHash is public the instant the round opens (before any bet
// can be placed), and resultNumber = HMAC-SHA256(serverSeed, periodNumber)
// mod 10 — deterministic and independently recomputable once serverSeed
// is revealed at settlement.
// Retired: the original Win Go. Kept (read-only) so past rounds and bets
// stay on record; nothing places or settles bets here any more except the
// one-time close-out in retiredGamesCloseout.ts. The live game is WinGo*.
model ColorGameRound {
  id              String         @id @default(uuid())
  durationSeconds Int
  // periodNumber (YYMMDD + that duration's 1-based round index for the
  // day — see periodNumberFor) is only unique WITHIN a duration: e.g.
  // 30s round #60 and 60s round #60 both land on "...000060" the same
  // day. Only @@unique below, not a bare @unique here, or two different
  // durations' rounds sharing a round index would collide on write and
  // silently return the wrong duration's round (a real bug this fixed —
  // see the commit that added this comment).
  periodNumber    String
  startTime       DateTime
  endTime         DateTime
  serverSeed      String?
  serverSeedHash  String
  resultNumber    Int?
  resultSize      ColorGameSize?
  settled         Boolean        @default(false)
  createdAt       DateTime       @default(now())
  bets            ColorGameBet[]

  @@unique([durationSeconds, periodNumber])
  @@index([durationSeconds, startTime])
}

model ColorGameBet {
  id               String           @id @default(uuid())
  roundId          String
  round            ColorGameRound   @relation(fields: [roundId], references: [id])
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  betType          ColorGameBetType
  betValue         String // "0".."9" | "GREEN"/"RED"/"VIOLET" | "BIG"/"SMALL"
  amount           Decimal          @db.Decimal(12, 2)
  payoutMultiplier Decimal          @db.Decimal(6, 2)
  status           BetStatus        @default(PENDING)
  payout           Decimal          @default(0) @db.Decimal(12, 2)
  createdAt        DateTime         @default(now())

  @@index([userId])
  @@index([roundId])
}

// "Aviator" — a provably-fair crash-multiplier game (see aviatorService.ts).
// Shared rounds like ColorGame, but continuous rather than slotted: each
// round chains directly off the previous one's endTime. crashMultiplier is
// deterministic from serverSeed the moment the round is created (commit-
// reveal, same as ColorGameRound), but is only exposed by the API once the
// round has actually reached it (now >= crashTime) — until then, nobody,
// including the server operator, can act on it early.
model AviatorRound {
  id               String       @id @default(uuid())
  periodNumber     String       @unique
  bettingStartTime DateTime
  flyStartTime     DateTime
  crashTime        DateTime
  endTime          DateTime
  crashMultiplier  Decimal      @db.Decimal(10, 2)
  serverSeed       String
  serverSeedHash   String
  settled          Boolean      @default(false)
  createdAt        DateTime     @default(now())
  bets             AviatorBet[]

  @@index([bettingStartTime])
}

model AviatorBet {
  id                String       @id @default(uuid())
  roundId           String
  round             AviatorRound @relation(fields: [roundId], references: [id])
  userId            String
  user              User         @relation(fields: [userId], references: [id])
  amount            Decimal      @db.Decimal(12, 2)
  autoCashoutAt     Decimal?     @db.Decimal(10, 2)
  cashoutMultiplier Decimal?     @db.Decimal(10, 2)
  status            BetStatus    @default(PENDING)
  payout            Decimal      @default(0) @db.Decimal(12, 2)
  createdAt         DateTime     @default(now())

  @@index([userId])
  @@index([roundId])
}

// One row per play — unlike Aviator/ColorGame there's no shared betting
// window here: each player starts, steps through, and cashes out (or
// busts) their own private round. status reuses BetStatus the same way
// AviatorBet does: PENDING while in progress, WON once cashed out, LOST
// once busted (VOID unused).
model ChickenRoadRound {
  id             String                @id @default(uuid())
  userId         String
  user           User                  @relation(fields: [userId], references: [id])
  difficulty     ChickenRoadDifficulty
  stake          Decimal               @db.Decimal(12, 2)
  currentStep    Int                   @default(0)
  multiplier     Decimal               @default(1) @db.Decimal(10, 2)
  payout         Decimal               @default(0) @db.Decimal(12, 2)
  status         BetStatus             @default(PENDING)
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  nonce          Int
  createdAt      DateTime              @default(now())
  settledAt      DateTime?

  @@index([userId])
}

// One private Mines round: a 5x5 board with `mineCount` hidden mines. The
// player reveals tiles one at a time; every safe tile raises the multiplier
// until they cash out or hit a mine. Mine positions are derived from the
// round's provably-fair seeds at start and stored here, but never sent to
// the client until the round has ended.
model MinesRound {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  stake          Decimal   @db.Decimal(12, 2)
  mineCount      Int
  minePositions  Int[]
  revealed       Int[]     @default([])
  multiplier     Decimal   @default(1) @db.Decimal(14, 2)
  payout         Decimal   @default(0) @db.Decimal(12, 2)
  status         BetStatus @default(PENDING)
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  nonce          Int
  createdAt      DateTime  @default(now())
  settledAt      DateTime?

  @@index([userId])
}

// "7 Up Down" — two provably-fair dice per shared, slot-aligned round (see
// sevenUpDownService.ts). The dice are fixed from serverSeed when the round
// is created and only exposed once resultTime has passed.
model SevenUpDownRound {
  id             String           @id @default(uuid())
  periodNumber   String           @unique
  startTime      DateTime
  betEndTime     DateTime
  resultTime     DateTime
  endTime        DateTime
  dice1          Int
  dice2          Int
  serverSeed     String
  serverSeedHash String
  settled        Boolean          @default(false)
  createdAt      DateTime         @default(now())
  bets           SevenUpDownBet[]

  @@index([startTime])
  @@index([settled, resultTime])
}

// One chip stack per row. area is DOWN | SEVEN | UP | N2..N12 (no N7);
// multiplier is the total return locked in when the bet was placed. VOID
// marks a bet taken back (undo/clear) during the betting window.
model SevenUpDownBet {
  id         String           @id @default(uuid())
  roundId    String
  round      SevenUpDownRound @relation(fields: [roundId], references: [id])
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  area       String
  amount     Decimal          @db.Decimal(12, 2)
  multiplier Decimal          @db.Decimal(8, 2)
  status     BetStatus        @default(PENDING)
  payout     Decimal          @default(0) @db.Decimal(12, 2)
  createdAt  DateTime         @default(now())

  @@index([userId])
  @@index([roundId, userId])
}

// "Plinko" — one row per ball dropped (see plinkoService.ts). path holds
// one 0 (left) / 1 (right) per row, drawn from the player's provably-fair
// seeds; slot is its sum. serverSeed is kept for audit but never sent.
model PlinkoBet {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  stake          Decimal  @db.Decimal(12, 2)
  rows           Int
  risk           String
  path           Int[]
  slot           Int
  multiplier     Decimal  @db.Decimal(10, 2)
  payout         Decimal  @db.Decimal(12, 2)
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  nonce          Int
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

// "Dragon Tiger" — one card each to Dragon and Tiger per shared,
// slot-aligned round (see dragonTigerService.ts). Cards are stored as
// 0..51 (rank = index % 13 + 1, suit = index / 13), fixed from serverSeed
// when the round is created and only exposed once resultTime has passed.
model DragonTigerRound {
  id             String           @id @default(uuid())
  periodNumber   String           @unique
  startTime      DateTime
  betEndTime     DateTime
  resultTime     DateTime
  endTime        DateTime
  dragonCard     Int
  tigerCard      Int
  serverSeed     String
  serverSeedHash String
  settled        Boolean          @default(false)
  createdAt      DateTime         @default(now())
  bets           DragonTigerBet[]

  @@index([startTime])
  @@index([settled, resultTime])
}

// area is DRAGON | TIE | TIGER | SUITED_TIE; multiplier is the total return
// locked in when the bet was placed. VOID marks a bet taken back (undo /
// clear) during the betting window.
model DragonTigerBet {
  id         String           @id @default(uuid())
  roundId    String
  round      DragonTigerRound @relation(fields: [roundId], references: [id])
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  area       String
  amount     Decimal          @db.Decimal(12, 2)
  multiplier Decimal          @db.Decimal(8, 2)
  status     BetStatus        @default(PENDING)
  payout     Decimal          @default(0) @db.Decimal(12, 2)
  createdAt  DateTime         @default(now())

  @@index([userId])
  @@index([roundId, userId])
}

// One private Vortex round. Every spin lands the wheel on Water, Earth,
// Fire or the vortex (crash). Each element fills a section of its ring and
// raises the multiplier; the player cashes out whenever they like, a full
// ring cashes out on its own, and the vortex loses the stake. `segments`
// keeps every landed wheel segment so the round can be replayed/verified.
model VortexRound {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  stake          Decimal   @db.Decimal(12, 2)
  water          Int       @default(0)
  earth          Int       @default(0)
  fire           Int       @default(0)
  spins          Int       @default(0)
  segments       Int[]
  multiplier     Decimal   @default(0) @db.Decimal(12, 2)
  payout         Decimal   @default(0) @db.Decimal(12, 2)
  status         BetStatus @default(PENDING)
  endReason      String?
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  nonce          Int
  createdAt      DateTime  @default(now())
  settledAt      DateTime?

  @@index([userId])
}

// One shared Andar Bahar round on a fixed wall-clock slot. `joker` and the
// dealt `cards` (Andar, Bahar, Andar, … up to and including the first card
// of the Joker's rank) are fixed at creation from the round's server seed
// and only revealed once betting has closed.
model AndarBaharRound {
  id             String          @id @default(uuid())
  periodNumber   String          @unique
  startTime      DateTime
  betEndTime     DateTime
  resultTime     DateTime
  endTime        DateTime
  joker          Int
  cards          Int[]
  serverSeed     String
  serverSeedHash String
  settled        Boolean         @default(false)
  createdAt      DateTime        @default(now())
  bets           AndarBaharBet[]

  @@index([startTime])
  @@index([settled, resultTime])
}

// One chip stack on an Andar Bahar area, at the multiplier locked in when
// placed. VOID marks a bet taken back during the betting window.
model AndarBaharBet {
  id         String          @id @default(uuid())
  roundId    String
  round      AndarBaharRound @relation(fields: [roundId], references: [id])
  userId     String
  user       User            @relation(fields: [userId], references: [id])
  area       String
  amount     Decimal         @db.Decimal(12, 2)
  multiplier Decimal         @db.Decimal(8, 2)
  status     BetStatus       @default(PENDING)
  payout     Decimal         @default(0) @db.Decimal(12, 2)
  createdAt  DateTime        @default(now())

  @@index([userId])
  @@index([roundId, userId])
}

// One shared Teen Patti 20-20 round on a fixed wall-clock slot. `cards`
// holds the six cards in deal order (A, B, A, B, A, B), fixed at creation
// from the round's server seed and only revealed once betting has closed.
model TeenPattiRound {
  id             String         @id @default(uuid())
  periodNumber   String         @unique
  startTime      DateTime
  betEndTime     DateTime
  resultTime     DateTime
  endTime        DateTime
  cards          Int[]
  serverSeed     String
  serverSeedHash String
  settled        Boolean        @default(false)
  createdAt      DateTime       @default(now())
  bets           TeenPattiBet[]

  @@index([startTime])
  @@index([settled, resultTime])
}

// One chip stack on a Teen Patti area, at the multiplier locked in when
// placed. VOID marks a bet taken back during the betting window.
model TeenPattiBet {
  id         String         @id @default(uuid())
  roundId    String
  round      TeenPattiRound @relation(fields: [roundId], references: [id])
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  area       String
  amount     Decimal        @db.Decimal(12, 2)
  multiplier Decimal        @db.Decimal(8, 2)
  status     BetStatus      @default(PENDING)
  payout     Decimal        @default(0) @db.Decimal(12, 2)
  createdAt  DateTime       @default(now())

  @@index([userId])
  @@index([roundId, userId])
}

// Cricket X: the Aviator crash engine with its own rounds and bets (see
// cricketXService.ts). Same fields and meaning as AviatorRound / AviatorBet.
model CricketXRound {
  id               String        @id @default(uuid())
