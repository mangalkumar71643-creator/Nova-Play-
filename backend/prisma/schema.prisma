  payout     Decimal    @default(0) @db.Decimal(12, 2)
  createdAt  DateTime   @default(now())

  @@index([userId])
  @@index([roundId, userId])
}

// Trx Win Go: Win Go's bets and odds, but each round's number is the last
// decimal digit of the hash of the first TRON block produced at or after the
// round's end, so anyone can check it on a TRON explorer. The block (and so
// the number) is unknown until the round is over; it is filled in at
// settlement. If the block can't be read for an hour the round is voided and
// every bet refunded.
model TrxRound {
  id              String    @id @default(uuid())
  durationSeconds Int
  periodNumber    String
  startTime       DateTime
  endTime         DateTime
  result          Int?
  blockNumber     Int?
  blockHash       String?
  blockTime       DateTime?
  voided          Boolean   @default(false)
  settled         Boolean   @default(false)
  createdAt       DateTime  @default(now())
  bets            TrxBet[]

  @@unique([durationSeconds, periodNumber])
  @@index([durationSeconds, startTime])
  @@index([settled, endTime])
  @@index([endTime])
}

// One Trx Win Go bet (same keys as WinGoBet: NUM:0-9, GREEN, RED, VIOLET,
// BIG, SMALL). The rate paid depends on the number drawn, so it is recorded
// at settlement in paidMultiplier.
model TrxBet {
  id             String    @id @default(uuid())
  roundId        String
  round          TrxRound  @relation(fields: [roundId], references: [id])
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  area           String
  amount         Decimal   @db.Decimal(12, 2)
  paidMultiplier Decimal   @default(0) @db.Decimal(8, 2)
  status         BetStatus @default(PENDING)
  payout         Decimal   @default(0) @db.Decimal(12, 2)
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([roundId, userId])
}

// "Baccarat" (punto banco) — shared, slot-aligned rounds (see
// baccaratService.ts). All six possible cards are drawn from serverSeed when
// the round is created (0..51, rank = index % 13 + 1, suit = index / 13);
// the third-card rule then decides how many of them are used. playerCards /
// bankerCards hold the cards actually dealt (2 or 3 each) and are only
// exposed once resultTime has passed.
model BaccaratRound {
  id             String        @id @default(uuid())
  periodNumber   String        @unique
  startTime      DateTime
  betEndTime     DateTime
  resultTime     DateTime
  endTime        DateTime
  playerCards    Int[]
  bankerCards    Int[]
  serverSeed     String
  serverSeedHash String
  settled        Boolean       @default(false)
  createdAt      DateTime      @default(now())
  bets           BaccaratBet[]

  @@index([startTime])
  @@index([settled, resultTime])
}

// area is PLAYER | BANKER | TIE | PLAYER_PAIR | BANKER_PAIR; multiplier is
// the total return locked in when the bet was placed. paidMultiplier is what
// was actually paid: the multiplier on a win, 1 when a Player/Banker bet is
// returned on a tie, 0 on a loss. VOID marks a bet taken back (undo /
// clear) during the betting window.
model BaccaratBet {
  id             String        @id @default(uuid())
  roundId        String
  round          BaccaratRound @relation(fields: [roundId], references: [id])
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  area           String
  amount         Decimal       @db.Decimal(12, 2)
  multiplier     Decimal       @db.Decimal(8, 2)
  paidMultiplier Decimal       @default(0) @db.Decimal(8, 2)
  status         BetStatus     @default(PENDING)
  payout         Decimal       @default(0) @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())

  @@index([userId])
  @@index([roundId, userId])
}

// One spin of the "Royal Gems" slot (see slotService.ts): three 3-row reels
// plus a multiplier reel. stops are the strip index shown on the top row of
// each reel, grid is the 3x3 result row by row, winLines the paylines that
// paid, baseWin the line total (x stake) before the multiplier.
model SlotSpin {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  stake          Decimal  @db.Decimal(12, 2)
  stops          Int[]
  grid           String[]
  winLines       Int[]
  baseWin        Decimal  @db.Decimal(10, 2)
  multiplier     Int
  payout         Decimal  @db.Decimal(12, 2)
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  nonce          Int
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

// One spin of "Golden Aces" (see acesService.ts / acesEngine.ts). The full
