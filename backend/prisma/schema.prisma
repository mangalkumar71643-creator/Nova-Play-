// Win Go (rebuilt): one number 0-9 per round on per-duration wall-clock
// tracks. `result` is fixed at creation from the round's server seed and
// only revealed once the round has ended.
model WinGoRound {
  id              String     @id @default(uuid())
  durationSeconds Int
  periodNumber    String
  startTime       DateTime
  endTime         DateTime
  result          Int
  serverSeed      String
  serverSeedHash  String
  settled         Boolean    @default(false)
  createdAt       DateTime   @default(now())
  bets            WinGoBet[]

  @@unique([durationSeconds, periodNumber])
  @@index([durationSeconds, startTime])
  @@index([settled, endTime])
}

// One Win Go bet (area: NUM:0-9, GREEN, RED, VIOLET, BIG, SMALL). The rate
// it pays depends on the number drawn (green/red pay less on 5/0), so it is
// recorded at settlement in paidMultiplier.
model WinGoBet {
  id             String     @id @default(uuid())
  roundId        String
  round          WinGoRound @relation(fields: [roundId], references: [id])
  userId         String
  user           User       @relation(fields: [userId], references: [id])
  area           String
  amount         Decimal    @db.Decimal(12, 2)
  paidMultiplier Decimal    @default(0) @db.Decimal(8, 2)
  status         BetStatus  @default(PENDING)
  payout         Decimal    @default(0) @db.Decimal(12, 2)
  createdAt      DateTime   @default(now())

  @@index([userId])
  @@index([roundId, userId])
}

// One 5D Lottery round: five digits A-E on the same per-duration wall-clock
// tracks as Win Go / K3. `digits` is fixed at creation from the round's
// server seed and only revealed once the round has ended.
model FiveDRound {
  id              String     @id @default(uuid())
  durationSeconds Int
  periodNumber    String
  startTime       DateTime
  endTime         DateTime
  digits          Int[]
  serverSeed      String
  serverSeedHash  String
  settled         Boolean    @default(false)
  createdAt       DateTime   @default(now())
  bets            FiveDBet[]

  @@unique([durationSeconds, periodNumber])
  @@index([durationSeconds, startTime])
  @@index([settled, endTime])
}

// One 5D bet on a bet key (see winsWith in fiveDService.ts), at the
// multiplier locked in when placed.
model FiveDBet {
