  userId    String
  user      User     @relation(fields: [userId], references: [id])
  claimKey  String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@unique([userId, claimKey])
}

// One private Penalty Hero round: up to 5 penalties against a keeper who
// covers 1-4 of the goal's 6 zones (by difficulty). Every goal raises the
// multiplier; a save loses the stake. Which zones the keeper covers on each
// kick comes from the round's seeds, fixed before the player picks a zone.
model PenaltyRound {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  /// EASY, MEDIUM, HARD or EXPERT: the keeper covers 1, 2, 3 or 4 zones.
  difficulty     String
  stake          Decimal   @db.Decimal(12, 2)
  /// Goals scored so far.
  goals          Int       @default(0)
  multiplier     Decimal   @default(1) @db.Decimal(10, 2)
  payout         Decimal   @default(0) @db.Decimal(12, 2)
  status         BetStatus @default(PENDING)
  /// Every kick taken: [{ zone, covered: number[], dive, saved }].
  shots          Json      @default("[]")
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  nonce          Int
  createdAt      DateTime  @default(now())
  settledAt      DateTime?

  @@index([userId, status])
}

// One private Lucky Cups round: up to 5 rounds of "find the ball" under one
// of 3 cups, with 1 or 2 balls. Every find raises the multiplier; a miss
// loses the stake. The ball cups for each round come from the round's seeds,
// fixed before the player picks.
model CupsRound {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  /// 1 or 2 balls under the 3 cups.
  balls          Int
  stake          Decimal   @db.Decimal(12, 2)
  /// Rounds won so far.
  wins           Int       @default(0)
  multiplier     Decimal   @default(1) @db.Decimal(10, 2)
  payout         Decimal   @default(0) @db.Decimal(12, 2)
  status         BetStatus @default(PENDING)
  /// Every pick: [{ cup, ballCups: number[], won }].
  picks          Json      @default("[]")
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  nonce          Int
  createdAt      DateTime  @default(now())
  settledAt      DateTime?

  @@index([userId, status])
}

// One private Bomb Squad round: a bomb with 8 wires, `live` of which set it
// off. The player cuts wires one at a time; every safe cut raises the
// multiplier until they cash out, cut a live wire, or cut every safe wire.
// The live wires come from the round's seeds, fixed when the round starts.
model BombRound {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  /// How many of the 8 wires are live: 2, 3 or 5.
  live           Int
  stake          Decimal   @db.Decimal(12, 2)
  /// Wires cut so far, in order (0-7).
  cuts           Json      @default("[]")
  safeCuts       Int       @default(0)
  multiplier     Decimal   @default(1) @db.Decimal(10, 2)
  payout         Decimal   @default(0) @db.Decimal(12, 2)
  status         BetStatus @default(PENDING)
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  nonce          Int
  createdAt      DateTime  @default(now())
  settledAt      DateTime?

  @@index([userId, status])
}

// One private Vault Heist round: a vault with 5 locks, each on a 0-9 dial
// where `alarms` of the 10 digits trip the alarm. Every lock cracked raises
// the multiplier; an alarm loses the stake. Each lock's alarm digits come
// from the round's seeds, fixed before the player picks.
model VaultRound {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  /// How many of the 10 digits trip the alarm on each lock: 2, 4 or 6.
  alarms         Int
  stake          Decimal   @db.Decimal(12, 2)
  /// Locks cracked so far.
  cracked        Int       @default(0)
  multiplier     Decimal   @default(1) @db.Decimal(10, 2)
  payout         Decimal   @default(0) @db.Decimal(12, 2)
  status         BetStatus @default(PENDING)
  /// Every try: [{ digit, alarmDigits: number[], ok }].
  tries          Json      @default("[]")
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  nonce          Int
  createdAt      DateTime  @default(now())
  settledAt      DateTime?

  @@index([userId, status])
}

// One private Treasure Dig round: an island of 16 sand mounds, `crabs` of
// which hide a crab. The player digs mounds one at a time; every treasure
// raises the multiplier until they cash out, dig up a crab, or clear every
// treasure. The crab mounds come from the round's seeds, fixed at the start.
model TreasureRound {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  /// How many of the 16 mounds hide a crab: 3, 5 or 8.
  crabs          Int
  stake          Decimal   @db.Decimal(12, 2)
  /// Mounds dug so far, in order (0-15, row by row).
  digs           Json      @default("[]")
  treasures      Int       @default(0)
  multiplier     Decimal   @default(1) @db.Decimal(12, 2)
  payout         Decimal   @default(0) @db.Decimal(12, 2)
  status         BetStatus @default(PENDING)
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  nonce          Int
  createdAt      DateTime  @default(now())
  settledAt      DateTime?

  @@index([userId, status])
}

// One Lucky Wheel spin: a 30-segment wheel at LOW, MEDIUM or HIGH risk; the
