DATABASE_URL="postgresql://postgres:postgres@localhost:5432/novaplay?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000

# Provider mode: "mock" for local dev, "live" once real provider credentials below are set.
KYC_PROVIDER_MODE="mock"
PAYMENT_PROVIDER_MODE="mock"
SMS_PROVIDER_MODE="mock"

# StockPay hosted UPI checkout (INR) — TEST MODE ONLY.
# Secret key from StockPay admin -> API Keys. Must start with sk_test_:
# live keys are rejected by the server and never enabled.
STOCKPAY_KEY=""
# Webhook secret from StockPay admin -> API Keys. Register
# https://<your-deployed-server>/webhooks/stockpay as the webhook URL there.
STOCKPAY_WEBHOOK_SECRET=""
# Phone numbers allowed to deposit in test mode, comma separated.
STOCKPAY_TEST_PHONES=""

# Fill these in with your real, licensed providers before going live.
# KYC_PROVIDER_API_KEY=
# PAYMENT_PROVIDER_API_KEY=
